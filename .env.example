# Clash 配置管理器 - 环境变量示例
#
# 用法：
#   - Docker：复制为 .env，用 `docker run --env-file .env ...` 传给容器
#   - 裸机：用系统环境变量（如 systemd 的 Environment=）或启动前 export
#
#   cp .env.example .env

# 本地构建产物的镜像名/标签（docker build -t 时使用）
#IMAGE=clash-config-manager:latest

# 时区
TZ=Asia/Shanghai

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=info

# 单个日志文件轮转阈值（字节），默认 5MB（5242880）
#LOG_MAX_BYTES=5242880

# 可选：覆盖 config.ini 的 [git] 段（方案 B，定时轮询 git 仓库）
# 留空则只用 config.ini，不会覆盖其配置
#GIT_PULL_ENABLED=
#GIT_REPO=
#GIT_BRANCH=
#GIT_INTERVAL=
#GIT_WORKSPACE=
