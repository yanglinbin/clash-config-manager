{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "outDir": "public/js",
    "rootDir": "src/web"
  },
  "include": ["src/web/**/*.ts"]
}
