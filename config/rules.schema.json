{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clash Rules Configuration Schema",
  "description": "Schema for rules.yaml (rule-providers + custom_rules + ruleset_rules)",
  "type": "object",
  "$comment": "YAML formatting rules: Use 2-space indentation, no tabs, consistent spacing for lists and objects",
  "properties": {
    "rule-providers": {
      "type": "object",
      "description": "Rule providers configuration",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["http", "file"]
            },
            "behavior": {
              "type": "string",
              "enum": ["domain", "ipcidr", "classical"]
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "path": {
              "type": "string"
            },
            "interval": {
              "type": "integer",
              "minimum": 60
            }
          },
          "required": ["type", "behavior", "path"],
          "additionalProperties": false
        }
      }
    },
    "custom_rules": {
      "type": "array",
      "description": "Custom rules as flat array with 2-space indentation (  - RULE-TYPE,param,proxy-group)",
      "items": {
        "type": "string",
        "pattern": "^(DOMAIN|DOMAIN-SUFFIX|DOMAIN-KEYWORD|DOMAIN-REGEX|IP-CIDR|IP-CIDR6|GEOIP|GEOSITE|SRC-IP-CIDR|SRC-IP-ASN|SRC-PORT|DST-PORT|PROCESS-NAME|PROCESS-PATH|RULE-SET|MATCH|AND|OR|NOT|SUB-RULE),",
        "examples": [
          "DOMAIN-SUFFIX,example.com,海外代理",
          "IP-CIDR,192.168.1.0/24,全球直连",
          "PROCESS-NAME,chrome.exe,海外代理"
        ]
      }
    },
    "ruleset_rules": {
      "type": "array",
      "description": "Rule-set reference rules (mixed rules; same accepted types as custom_rules)",
      "items": {
        "type": "string",
        "pattern": "^(DOMAIN|DOMAIN-SUFFIX|DOMAIN-KEYWORD|DOMAIN-REGEX|IP-CIDR|IP-CIDR6|GEOIP|GEOSITE|SRC-IP-CIDR|SRC-IP-ASN|SRC-PORT|DST-PORT|PROCESS-NAME|PROCESS-PATH|RULE-SET|MATCH|AND|OR|NOT|SUB-RULE),"
      }
    }
  },
  "required": ["rule-providers", "custom_rules", "ruleset_rules"],
  "additionalProperties": false
}
