{
  "name": "clash-config-manager",
  "version": "2.0.0",
  "private": true,
  "description": "Clash 配置管理器（TypeScript 版）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.web.json",
    "build:server": "tsup",
    "build:web": "tsc -p tsconfig.web.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "generate": "node dist/cli/generate.js",
    "lint:rules": "node dist/cli/lint.js",
    "migrate:groups": "node dist/cli/migrateGroups.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.json\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "ajv": "^8.20.0",
    "fastify": "^5.2.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.8"
  }
}
