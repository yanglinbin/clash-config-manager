# ============================================================
# Clash Config Manager 主配置示例
# 复制为 config.ini 后按需修改。
#
# 本文件只保留「订阅源 / 地区关键词 / 排除词 / 基础参数 / git」；
# 代理组结构（主组 / 地区组 / 自定义组 / 特殊组）在 config/groups.yaml 中定义。
# 生成时把 active_provider 的订阅链接写入 proxy-providers，
# 节点由 Clash 客户端自行拉取，服务器无需访问订阅源。
# ============================================================

[proxy_providers]
# 订阅源配置：可维护任意多个，但只有 [provider_control] active_provider
# 指定的那一个参与生成
# 格式: 配置名称 = 订阅URL
# 名称统一转为大写，供其他配置节引用
XXAI = https://your-subscription-url-1
NAIYUN = https://your-subscription-url-2

[provider_control]
# 单一供应商模式：必填，指定唯一参与生成的订阅源
# 未配置或指定的名称不存在时，生成失败并保留旧配置
active_provider = XXAI

[regions]
# 地区关键词词典：每个地区在 groups.yaml 中对应一个地区组
# 格式: 地区名称 = 匹配关键词1,匹配关键词2
# 节点名包含任一关键词即归入该地区组
香港 = Hong Kong,HK,香港,HongKong
台湾 = Taiwan,TW,台湾,Taipei
日本 = Japan,JP,日本,Tokyo
美国 = United States,US,美国,America,USA
新加坡 = Singapore,SG,新加坡,狮城

[filter]
# 节点过滤：节点名包含任一关键词则不会出现在生成的任何组中（全局排除）
# 这些关键词会转成策略组 filter 的负向前瞻，
# 因此主组和地区组里的“剩余流量/官网/到期”等信息节点都会被排除。
# 留空 = 不排除任何节点。
exclude_keywords = 网址,剩余,流量,重置,套餐,如遇,永久,官方,群组,欢迎,官网,频道,个人,到期,续费

[files]
# 规则配置文件路径（规则只来自本地文件）
rules_config = config/rules.yaml
# 分组结构文件路径
groups_config = config/groups.yaml

[git]
# 方案 B：应用内定时轮询 git 仓库，检测配置/规则变化后自动重新生成。
# 服务器主动出站拉取（公开仓库匿名 https），不依赖任何入站连接。
# 拉取失败时自动回退到挂载的 config/rules.yaml，不影响服务。
enable = false
repo = https://github.com/yanglinbin/clash-config-manager.git
branch = main
interval = 300                                    # 轮询间隔（秒，最小 10）
# workspace = repo                                # 相对项目根；默认 <项目根>/repo（容器内 /app/repo）
watched_paths = config/rules.yaml,config/groups.yaml

[clash]
# 生成 Clash 配置的基础参数
port = 7890
socks_port = 7891
allow_lan = true
mode = Rule
log_level = info
external_controller = :9090
test_url = http://connectivitycheck.gstatic.com/generate_204

# ============ 环境变量（docker run -e / 启动环境） ============
# APP_PORT              - Web 服务监听端口（默认 5000）
# LOG_LEVEL             - 日志级别: DEBUG/INFO/WARNING/ERROR（默认 INFO）
