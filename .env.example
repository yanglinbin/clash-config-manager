# Clash 配置管理器 - 环境变量示例
#
# 用法：复制为 .env（compose.yaml 会自动读取）
#   cp .env.example .env

# 本地构建产物的镜像名/标签（compose.yaml 中 app 服务使用）
#IMAGE=clash-config-manager:latest

# 时区
TZ=Asia/Shanghai

# 对外暴露端口
HTTP_PORT=80
HTTPS_PORT=443

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=info

# 单个日志文件轮转阈值（字节），默认 5MB（5242880）
#LOG_MAX_BYTES=5242880

# 可选：覆盖 config.ini 的 [git] 段（方案 B，定时轮询 git 仓库）
# 留空则只用 config.ini，不会覆盖其配置
#GIT_PULL_ENABLED=
#GIT_REPO=
#GIT_BRANCH=
#GIT_INTERVAL=
#GIT_WORKSPACE=
