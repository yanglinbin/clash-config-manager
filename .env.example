# Clash 配置管理器 - 环境变量示例
#
# 用法：复制为 .env（compose.yaml 会自动读取）
#   cp .env.example .env

# 本地构建产物的镜像名/标签（compose.yaml 中 app 服务使用）
#IMAGE=clash-config-manager:latest

# 时区
TZ=Asia/Shanghai

# 对外暴露端口
HTTP_PORT=80
HTTPS_PORT=443

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=info

# GitHub Webhook 签名校验密钥（留空则禁用 /webhook/github）
# 生成：openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
